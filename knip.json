{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-types.json",
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/app/**/*.{js,jsx,ts,tsx,mjs}",
        "src/emails/templates/**/*.{js,jsx,ts,tsx}",
        "scripts/**/*.mjs"
      ],
      "project": ["src/**/*.{js,jsx,ts,tsx,mjs}", "scripts/**/*.mjs"],
      "paths": {
        "@/*": ["./src/*"]
      },
      "ignore": ["src/components/ui/**", "src/components/reui/**"]
    },
    "workers/outbox-dispatch": {
      "project": ["src/**/*.js"]
    }
  },
  "ignoreDependencies": ["tw-animate-css", "wrangler"],
  "ignoreBinaries": ["agentation-mcp"],
  "ignoreExportsUsedInFile": true
}

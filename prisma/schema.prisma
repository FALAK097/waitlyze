generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @unique @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  imageUrl      String?
  isOnboarded   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  personalWorkspace    Workspace?        @relation("PersonalWorkspace")
  workspaceMemberships WorkspaceMember[]

  waitLists WaitList[]
  apiKeys   ApiKey[]
  sessions  Session[]
  accounts  Account[]

  @@map("users")
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum ReferralReviewStatus {
  CLEAR
  NEEDS_REVIEW
  APPROVED
  EXCLUDED
}

enum LaunchRehearsalStatus {
  PASSED
  NEEDS_ATTENTION
}

model WaitList {
  status                  CampaignStatus @default(DRAFT)
  publicSlug              String? @unique
  templateSnapshot        Json?
  templateRevision        Int @default(1)
  templateRevisions       WaitListRevision[]
  publicationRevisions    WaitListPublicationRevision[]
  publishedRevision       Int?
  publishedTemplateRevision Int?
  creationKey             String?

  id                      String  @id @unique @default(cuid())
  name                    String?
  description             String?
  websiteUrl              String?
  logoUrl                 String? @default("/images/logo.png")
  logoKey                 String?
  buttonColor             String? @default("#FF6B4A")
  buttonBorder            String? @default("#FF9D7A")
  buttonTextColor         String? @default("#FFFFFF")
  mainBgColor             String? @default("#FFFFFF")
  enableMainBgColor       Boolean @default(false)
  bgColor                 String? @default("#FFFFFF")
  enableBgColor           Boolean @default(false)
  borderWidth             String? @default("0px")
  borderRadius            String? @default("large")
  fontWeight              String? @default("normal")
  logoSize                String? @default("1X")
  buttonText              String? @default("Join the waitlist")
  successMessage          String? @default("Success! You're on the waitlist")
  showLogo                Boolean @default(true)
  showSocialProof         Boolean @default(true)
  showBadge               Boolean @default(true)
  showBranding            Boolean @default(true)
  showReferrals           Boolean @default(true)
  badgeColor              String? @default("#FF9D7A")
  badgeText               String? @default("Sign Up to get early access")
  badgeTextColor          String? @default("#FFFFFF")
  inputColor              String? @default("#FFFFF")
  inputBorder             String? @default("#E5E7EB")
  inputTextColor          String? @default("#000000")
  placeholderText         String? @default("Enter your email")
  twitterLink             String?
  facebookLink            String?
  instagramLink           String?
  linkedInLink            String?
  showSocialLinks         Boolean @default(true)
  sendEmailsToSubscribers Boolean @default(false)
  ogTitle                 String?
  ogDescription           String?
  ogImage                 String?
  shareOnTwitter          Boolean @default(true)
  shareOnWhatsapp         Boolean @default(true)
  shareOnLinkedin         Boolean @default(true)
  shareOnInstagram        Boolean @default(false)
  shareOnFacebook         Boolean @default(false)
  shareOnEmail            Boolean @default(false)
  shareOnReddit           Boolean @default(false)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  signUps              SignUp[]
  impressions          Impression[]
  launchRehearsals     LaunchRehearsal[]
  apiKeys              ApiKey[]
  emailTemplateRecords EmailTemplate[]
  broadcasts           MarketingBroadcast[]
  marketingConsentEvents MarketingConsentEvent[]
  automationRecipes      AutomationRecipe[]
  automationRuns         AutomationRun[]

  @@unique([workspaceId, creationKey])
  @@index([workspaceId, status])
  @@index([workspaceId, id])
  @@index([userId, workspaceId])
  @@map("wait_lists")
}

model WaitListRevision {
  id           String   @id @default(cuid())
  waitListId   String
  revision     Int
  snapshot     Json
  createdAt    DateTime @default(now())
  waitList     WaitList @relation(fields: [waitListId], references: [id], onDelete: Cascade)

  @@unique([waitListId, revision])
  @@index([waitListId, createdAt])
  @@map("wait_list_revisions")
}

model WaitListPublicationRevision {
  id             String   @id @default(cuid())
  waitListId     String
  revision       Int
  templateRevision Int
  snapshot       Json
  createdAt      DateTime @default(now())
  waitList       WaitList @relation(fields: [waitListId], references: [id], onDelete: Cascade)

  @@unique([waitListId, revision])
  @@index([waitListId, createdAt])
  @@map("wait_list_publication_revisions")
}

model SignUp {
  id              String      @id @default(cuid())
  uniqueUserId    String
  referralCode    String      @unique @default(dbgenerated("gen_random_uuid()::text"))
  email           String
  emailNormalized String?
  device          String?
  deviceType      String?
  city            String?
  country         String?
  timezone        String?
  ipAddress       String?
  latitude        String?
  longitude       String?
  waitListId      String
  impressionId    String?
  rank            Int?
  signUpEmailSent Boolean     @default(false)
  verifiedAt      DateTime?
  marketingConsentAt DateTime?
  marketingUnsubscribedAt DateTime?
  unsubscribeTokenHash String? @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  waitList        WaitList    @relation(fields: [waitListId], references: [id], onDelete: Cascade)
  impression      Impression? @relation(fields: [impressionId], references: [id], onDelete: SetNull)
  referrals       Referral[]  @relation("referredByReferral")
  referredBy      Referral[]  @relation("signUpReferral")
  verification    SignUpVerification?
  broadcastRecipients BroadcastRecipient[]
  marketingConsentEvents MarketingConsentEvent[]
  automationRuns AutomationRun[]

  @@unique([waitListId, emailNormalized])
  @@index([waitListId, uniqueUserId])
  @@index([waitListId, createdAt, id])
  @@map("sign_ups")
}

model SignUpVerification {
  id        String   @id @default(cuid())
  signUpId  String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  signUp    SignUp   @relation(fields: [signUpId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sign_up_verifications")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model OutboxEvent {
  id          String       @id @default(cuid())
  eventKey    String       @unique
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  processedAt DateTime?
  lockedAt    DateTime?
  waitListId  String?
  providerMessageId String?
  lastErrorCode String?

  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@map("outbox_events")
}

enum BroadcastStatus {
  DRAFT
  SENDING
  SENT
  CANCELED
  FAILED
}

enum BroadcastRecipientStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  SKIPPED
  CANCELED
}

enum MarketingConsentAction {
  OPTED_IN
  OPTED_OUT
}

enum MarketingConsentSource {
  PUBLIC_SIGNUP
  PUBLIC_UNSUBSCRIBE
}

model MarketingConsentEvent {
  id        String                 @id @default(cuid())
  waitListId String
  signUpId  String
  action    MarketingConsentAction
  source    MarketingConsentSource
  consentText String?
  createdAt DateTime               @default(now())
  waitList  WaitList               @relation(fields: [waitListId], references: [id], onDelete: Cascade)
  signUp    SignUp                 @relation(fields: [signUpId], references: [id], onDelete: Cascade)

  @@index([signUpId, createdAt])
  @@index([waitListId, createdAt])
  @@map("marketing_consent_events")
}

model MarketingBroadcast {
  id             String          @id @default(cuid())
  waitListId     String
  waitList       WaitList        @relation(fields: [waitListId], references: [id], onDelete: Cascade)
  name           String
  subject        String
  previewText    String
  body           String
  status         BroadcastStatus @default(DRAFT)
  recipientCount Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sentAt         DateTime?
  recipients     BroadcastRecipient[]

  @@index([waitListId, updatedAt])
  @@map("marketing_broadcasts")
}

model BroadcastRecipient {
  id                String                   @id @default(cuid())
  broadcastId       String
  broadcast         MarketingBroadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  signUpId          String
  signUp            SignUp                   @relation(fields: [signUpId], references: [id], onDelete: Cascade)
  email             String
  emailNormalized   String
  status            BroadcastRecipientStatus @default(PENDING)
  providerMessageId String?
  lastErrorCode     String?
  deliveredAt       DateTime?
  createdAt         DateTime                 @default(now())

  @@unique([broadcastId, signUpId])
  @@index([broadcastId, status])
  @@map("broadcast_recipients")
}

enum AutomationRecipeType {
  WELCOME
  REFERRAL_REMINDER
  REFERRAL_MILESTONE
}

enum AutomationRecipeStatus {
  DRAFT
  ENABLED
  PAUSED
}

enum AutomationRunStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
  CANCELED
}

enum AutomationStepStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
  CANCELED
}

model AutomationRecipe {
  id             String                @id @default(cuid())
  waitListId     String
  waitList       WaitList              @relation(fields: [waitListId], references: [id], onDelete: Cascade)
  type           AutomationRecipeType
  status         AutomationRecipeStatus @default(DRAFT)
  currentVersion Int                   @default(1)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  versions       AutomationRecipeVersion[]
  runs           AutomationRun[]

  @@unique([waitListId, type])
  @@index([waitListId, status])
  @@map("automation_recipes")
}

model AutomationRecipeVersion {
  id        String           @id @default(cuid())
  recipeId  String
  recipe    AutomationRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version   Int
  config    Json
  createdAt DateTime         @default(now())
  runs      AutomationRun[]

  @@unique([recipeId, version])
  @@map("automation_recipe_versions")
}

model AutomationRun {
  recipeId         String
  recipe           AutomationRecipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  id               String                 @id @default(cuid())
  recipeVersionId  String
  recipeVersion    AutomationRecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  waitListId       String
  waitList         WaitList               @relation(fields: [waitListId], references: [id], onDelete: Cascade)
  signUpId         String
  signUp           SignUp                 @relation(fields: [signUpId], references: [id], onDelete: Cascade)
  triggerKey       String
  status           AutomationRunStatus    @default(PENDING)
  scheduledAt      DateTime
  startedAt        DateTime?
  finishedAt       DateTime?
  skipReason       String?
  createdAt        DateTime               @default(now())
  steps            AutomationRunStep[]

  @@unique([recipeId, triggerKey])
  @@index([waitListId, createdAt])
  @@index([status, scheduledAt])
  @@map("automation_runs")
}

model AutomationRunStep {
  id                String               @id @default(cuid())
  runId             String
  run               AutomationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepKey           String
  position          Int                  @default(0)
  status            AutomationStepStatus @default(PENDING)
  availableAt       DateTime
  outboxEventKey    String               @unique
  providerMessageId String?
  lastErrorCode     String?
  createdAt         DateTime             @default(now())
  finishedAt        DateTime?

  @@unique([runId, stepKey])
  @@index([runId, position])
  @@index([status, availableAt])
  @@map("automation_run_steps")
}

model Impression {
  id           String   @id @default(cuid())
  uniqueUserId String
  device       String?
  deviceType   String?
  city         String?
  country      String?
  timezone     String?
  ipAddress    String?
  latitude     String?
  longitude    String?
  waitListId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  waitList     WaitList @relation(fields: [waitListId], references: [id], onDelete: Cascade)
  signUps      SignUp[]

  @@map("impressions")
}

model Referral {
  id           String   @id @default(cuid())
  signUpId     String   @unique
  referredById String?
  reviewStatus ReferralReviewStatus @default(CLEAR)
  reviewReason String?
  resolution   String?
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  signUp       SignUp   @relation("signUpReferral", fields: [signUpId], references: [id], onDelete: Cascade)
  referredBy   SignUp?  @relation("referredByReferral", fields: [referredById], references: [id], onDelete: Cascade)

  @@index([referredById, reviewStatus])
  @@map("referrals")
}

// Rehearsal records contain checklist results only. Simulated activity never
// becomes a SignUp, OutboxEvent, impression, or report input.
model LaunchRehearsal {
  id            String                @id @default(cuid())
  waitListId    String
  status        LaunchRehearsalStatus
  checksPassed  Int
  checksFailed  Int
  checkResults  Json
  createdAt     DateTime              @default(now())
  waitList      WaitList              @relation(fields: [waitListId], references: [id], onDelete: Cascade)

  @@index([waitListId, createdAt])
  @@map("launch_rehearsal_runs")
}

model ApiKey {
  id         String   @id @default(cuid())
  name       String
  keyHash    String   @unique
  userId     String
  waitlistId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  waitlist WaitList? @relation(fields: [waitlistId], references: [id], onDelete: SetNull)

  @@map("api_keys")
}

model EmailTemplate {
  id          String            @id @default(cuid())
  waitListId  String
  waitList    WaitList          @relation(fields: [waitListId], references: [id], onDelete: Cascade)
  type        EmailTemplateType
  subject     String
  previewText String
  header      String
  subHeader   String
  mainBody    String
  subBody     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([waitListId, type])
  @@map("email_templates")
}

enum EmailTemplateType {
  SIGNUP
  OFFBOARDING
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// Additive tenancy: personalOwnerId provides an idempotent legacy mapping.
model Workspace {
  id              String            @id @default(cuid())
  name            String
  personalOwnerId String?           @unique
  personalOwner   User?             @relation("PersonalWorkspace", fields: [personalOwnerId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  members         WorkspaceMember[]
  waitLists       WaitList[]
  emailSuppressions EmailSuppression[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId, workspaceId])
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model EmailProviderEvent {
  id                String   @id @default(cuid())
  providerEventId   String   @unique
  providerMessageId String
  type              String
  isPermanent       Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([providerMessageId, type])
  @@map("email_provider_events")
}

model EmailSuppression {
  id              String   @id @default(cuid())
  workspaceId     String
  emailNormalized String
  reason          String
  createdAt       DateTime @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, emailNormalized])
  @@index([workspaceId, createdAt])
  @@map("email_suppressions")
}

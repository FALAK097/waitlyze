generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @unique @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  imageUrl      String?
  isOnboarded   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  personalWorkspace    Workspace?        @relation("PersonalWorkspace")
  workspaceMemberships WorkspaceMember[]

  waitLists WaitList[]
  apiKeys   ApiKey[]
  sessions  Session[]
  accounts  Account[]

  @@map("users")
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

model WaitList {
  status                  CampaignStatus @default(DRAFT)
  publicSlug              String? @unique
  templateSnapshot        Json?
  creationKey             String?

  id                      String  @id @unique @default(cuid())
  name                    String?
  description             String?
  websiteUrl              String?
  logoUrl                 String? @default("/images/logo.png")
  logoKey                 String?
  buttonColor             String? @default("#FF6B4A")
  buttonBorder            String? @default("#FF9D7A")
  buttonTextColor         String? @default("#FFFFFF")
  mainBgColor             String? @default("#FFFFFF")
  enableMainBgColor       Boolean @default(false)
  bgColor                 String? @default("#FFFFFF")
  enableBgColor           Boolean @default(false)
  borderWidth             String? @default("0px")
  borderRadius            String? @default("large")
  fontWeight              String? @default("normal")
  logoSize                String? @default("1X")
  buttonText              String? @default("Join the waitlist")
  successMessage          String? @default("Success! You're on the waitlist")
  showLogo                Boolean @default(true)
  showSocialProof         Boolean @default(true)
  showBadge               Boolean @default(true)
  showBranding            Boolean @default(true)
  showReferrals           Boolean @default(true)
  badgeColor              String? @default("#FF9D7A")
  badgeText               String? @default("Sign Up to get early access")
  badgeTextColor          String? @default("#FFFFFF")
  inputColor              String? @default("#FFFFF")
  inputBorder             String? @default("#E5E7EB")
  inputTextColor          String? @default("#000000")
  placeholderText         String? @default("Enter your email")
  twitterLink             String?
  facebookLink            String?
  instagramLink           String?
  linkedInLink            String?
  showSocialLinks         Boolean @default(true)
  sendEmailsToSubscribers Boolean @default(false)
  ogTitle                 String?
  ogDescription           String?
  ogImage                 String?
  shareOnTwitter          Boolean @default(true)
  shareOnWhatsapp         Boolean @default(true)
  shareOnLinkedin         Boolean @default(true)
  shareOnInstagram        Boolean @default(false)
  shareOnFacebook         Boolean @default(false)
  shareOnEmail            Boolean @default(false)
  shareOnReddit           Boolean @default(false)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  signUps              SignUp[]
  impressions          Impression[]
  apiKeys              ApiKey[]
  emailTemplateRecords EmailTemplate[]

  @@unique([workspaceId, creationKey])
  @@index([workspaceId, status])
  @@index([workspaceId, id])
  @@index([userId, workspaceId])
  @@map("wait_lists")
}

model SignUp {
  id              String      @id @default(cuid())
  uniqueUserId    String
  email           String
  device          String?
  deviceType      String?
  city            String?
  country         String?
  timezone        String?
  ipAddress       String?
  latitude        String?
  longitude       String?
  waitListId      String
  impressionId    String?
  rank            Int?
  signUpEmailSent Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  waitList        WaitList    @relation(fields: [waitListId], references: [id], onDelete: Cascade)
  impression      Impression? @relation(fields: [impressionId], references: [id], onDelete: SetNull)
  referrals       Referral[]  @relation("referredByReferral")
  referredBy      Referral[]  @relation("signUpReferral")

  @@map("sign_ups")
}

model Impression {
  id           String   @id @default(cuid())
  uniqueUserId String
  device       String?
  deviceType   String?
  city         String?
  country      String?
  timezone     String?
  ipAddress    String?
  latitude     String?
  longitude    String?
  waitListId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  waitList     WaitList @relation(fields: [waitListId], references: [id], onDelete: Cascade)
  signUps      SignUp[]

  @@map("impressions")
}

model Referral {
  id           String   @id @default(cuid())
  signUpId     String   @unique
  referredById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  signUp       SignUp   @relation("signUpReferral", fields: [signUpId], references: [id], onDelete: Cascade)
  referredBy   SignUp?  @relation("referredByReferral", fields: [referredById], references: [id], onDelete: Cascade)

  @@map("referrals")
}

model ApiKey {
  id         String   @id @default(cuid())
  name       String
  keyHash    String   @unique
  userId     String
  waitlistId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  waitlist WaitList? @relation(fields: [waitlistId], references: [id], onDelete: SetNull)

  @@map("api_keys")
}

model EmailTemplate {
  id          String            @id @default(cuid())
  waitListId  String
  waitList    WaitList          @relation(fields: [waitListId], references: [id], onDelete: Cascade)
  type        EmailTemplateType
  subject     String
  previewText String
  header      String
  subHeader   String
  mainBody    String
  subBody     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([waitListId, type])
  @@map("email_templates")
}

enum EmailTemplateType {
  SIGNUP
  OFFBOARDING
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// Additive tenancy: personalOwnerId provides an idempotent legacy mapping.
model Workspace {
  id              String            @id @default(cuid())
  name            String
  personalOwnerId String?           @unique
  personalOwner   User?             @relation("PersonalWorkspace", fields: [personalOwnerId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  members         WorkspaceMember[]
  waitLists       WaitList[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId, workspaceId])
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

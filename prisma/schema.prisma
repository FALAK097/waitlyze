generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  firstName   String?
  lastName    String?
  imageUrl    String?
  clerkUserId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  waitLists WaitList[]

  @@map("users")
}

model WaitList {
  id                String  @id @default(cuid())
  name              String?
  websiteUrl        String?
  logoUrl           String?
  buttonColor       String?
  buttonBorder      String?
  buttonTextColor   String?
  bgColor           String?
  borderWidth       String?
  borderRadius      String?
  fontWeight        String?
  logoSize          String?
  buttonText        String?
  successMessage    String?
  showLogo          Boolean @default(true)
  showSocialProof   Boolean @default(true)
  enableReferrals   Boolean @default(false)
  inputColor        String?
  inputBorder       String?
  inputTextColor    String?
  placeholderText   String?
  twitterLink       String?
  facebookLink      String?
  instagramLink     String?
  linkedInLink      String?
  showSocialLinks   Boolean @default(true)
  userId            String
  user              User    @relation(fields: [userId], references: [id])
  signUps           SignUp[]

  @@map("wait_lists")
}

model SignUp {
  id         String   @id @default(cuid())
  email      String
  device     String?
  region     String?
  ipAddress  String?
  lattitude  String?
  longitude  String?
  waitListId String
  waitList   WaitList @relation(fields: [waitListId], references: [id])

  @@map("sign_ups")
}

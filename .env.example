# Postgres Database URL
DATABASE_URL=

# Node Environment
NODE_ENV=development

# Better Auth
BETTER_AUTH_SECRET="your_32_character_long_secret_key"
MARKETING_UNSUBSCRIBE_SECRET="use-a-dedicated-stable-32-character-or-longer-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Optional - add to enable Google Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Fonts catalog (server-only; used by the Builder font picker)
GOOGLE_FONTS_API_KEY=""

# Cloudflare R2
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_r2_bucket_name"
NEXT_PUBLIC_R2_PUBLIC_URL="https://assets.waitlyze.com"

# Optional: Cloudflare Turnstile bot protection for waitlist signup forms.
# The site key is pasted per waitlist in the Builder and MUST be the widget
# paired with the secret below - any other key fails verification. Both unset
# keeps the default off-path untouched.
TURNSTILE_SECRET_KEY=""
TURNSTILE_SITE_KEY=""

# Optional: enable owner-managed custom waitlist domains through Cloudflare for SaaS.
# Use a zone-scoped API token with SSL and Certificates read/write permissions.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_CUSTOM_HOSTNAME_TARGET="customers.waitlyze.com"
APP_ROOT_DOMAIN="waitlyze.com"

# Optional: protect POST /api/internal/email-outbox when called by a scheduler
OUTBOX_DISPATCH_SECRET="replace-with-a-long-random-secret"
WEBHOOK_SECRET_ENCRYPTION_KEY="base64-encoded-32-byte-key-for-webhook-and-integration-secrets"
